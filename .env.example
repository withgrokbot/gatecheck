# Gatecheck configuration. Copy to .env and fill in.
# TESTNET-FIRST: every money path defaults to Base Sepolia. Mainnet needs
# BOTH GATECHECK_NETWORK=eip155:8453 AND GATECHECK_LIVE_MAINNET=1.

# What buyers pay Gatecheck (the shop's receiving wallet, Base)
GATECHECK_PAY_TO=0xYourShopWalletHere

# Network Gatecheck charges on. Default is Base Sepolia (testnet).
# Set to eip155:8453 for Base mainnet (also requires GATECHECK_LIVE_MAINNET=1).
GATECHECK_NETWORK=eip155:84532

# Second key to arm mainnet. Any other value (or unset) = testnet behavior.
GATECHECK_LIVE_MAINNET=0

# Facilitator verifying buyer payments to Gatecheck
FACILITATOR_URL=https://x402.org/facilitator

# Wallet Gatecheck pays FROM when buying the 402xAgent spot-check ($0.02).
# Required only for SPOTCHECK_MODE=live. NEVER commit a real key.
GATECHECK_WALLET_KEY=

# Upstream spot-check: "dryrun" (default, simulated $0.02 spend, fixture
# verdict) or "live" (real x402 payment to api.402xagent.com/v1/lookup/paid).
SPOTCHECK_MODE=dryrun

# Optional integrator key for 402xAgent (format 402x_live_...)
SPOTCHECK_API_KEY=

# Base RPC for the wash-signal funding-source check (v1). Public default is fine.
BASE_RPC_URL=https://mainnet.base.org

# Treasury
TREASURY_SEED_USDC=50
GAS_PER_REPORT_USDC=0.001
LITE_DAILY_LOSS_CAP_USDC=2
FREE_DAILY_BUDGET_USDC=5

# Kill switch: set to 1 to refuse all sales at boot.
GATECHECK_KILL=0
# Admin key for POST /v1/admin/kill and /v1/admin/resume
# Admin endpoints are disabled unless this is set to a random value of 16+ chars.
GATECHECK_ADMIN_KEY=

# ed25519 receipt signing key (base64, 32 bytes). Generated and saved to
# data/gatecheck-ed25519.json on first boot if unset.
GATECHECK_SIGNING_KEY=

PORT=3402
